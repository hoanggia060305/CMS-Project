@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">

    <!-- HEADER -->
    <div class="text-center mb-5">

        <h1 class="display-3 fw-bold text-dark">
            CMS MANAGEMENT SYSTEM
        </h1>

        <p class="lead text-secondary">
            ASP.NET Core MVC + Entity Framework Core
        </p>

    </div>

    <!-- DASHBOARD -->
    <div class="row g-4">

        <!-- CATEGORY -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-tags-fill text-primary"
                           style="font-size:60px;"></i>
                    </div>

                    <h3 class="fw-bold text-primary">
                        Categories
                    </h3>

                    <p class="text-muted">
                        Manage all product categories in system.
                    </p>

                    <a href="/Category"
                       class="btn btn-primary px-4 rounded-pill">

                        View Categories
                    </a>

                </div>

            </div>

        </div>

        <!-- PRODUCT -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-box-seam-fill text-success"
                           style="font-size:60px;"></i>
                    </div>

                    <h3 class="fw-bold text-success">
                        Products
                    </h3>

                    <p class="text-muted">
                        Manage products, stock and prices.
                    </p>

                    <a href="/Product"
                       class="btn btn-success px-4 rounded-pill">

                        View Products
                    </a>

                </div>

            </div>

        </div>

        <!-- CUSTOMER -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-people-fill text-danger"
                           style="font-size:60px;"></i>
                    </div>

                    <h3 class="fw-bold text-danger">
                        Customers
                    </h3>

                    <p class="text-muted">
                        Manage customer information and accounts.
                    </p>

                    <a href="/Customer"
                       class="btn btn-danger px-4 rounded-pill">

                        View Customers
                    </a>

                </div>

            </div>

        </div>

        <!-- ORDER -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-cart-check-fill text-warning"
                           style="font-size:60px;"></i>
                    </div>

                    <h3 class="fw-bold text-warning">
                        Orders
                    </h3>

                    <p class="text-muted">
                        Track and manage customer orders.
                    </p>

                    <a href="/Order"
                       class="btn btn-warning px-4 rounded-pill">

                        View Orders
                    </a>

                </div>

            </div>

        </div>

        <!-- ORDER DETAIL -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-receipt-cutoff text-info"
                           style="font-size:60px;"></i>
                    </div>

                    <h3 class="fw-bold text-info">
                        Order Details
                    </h3>

                    <p class="text-muted">
                        Manage detailed items inside orders.
                    </p>

                    <a href="/OrderDetail"
                       class="btn btn-info px-4 rounded-pill text-white">

                        View Order Details
                    </a>

                </div>

            </div>

        </div>

        <!-- CATEGORY PRODUCT -->
        <div class="col-lg-4 col-md-6">

            <div class="card border-0 shadow-lg rounded-4 h-100">

                <div class="card-body text-center p-5">

                    <div class="mb-4">
                        <i class="bi bi-diagram-3-fill text-secondary"
                           style="font-size:60px;"></i>
                    </div>

                    <h3 class="fw-bold text-secondary">
                        Categories Products
                    </h3>

                    <p class="text-muted">
                        Manage product category relationships.
                    </p>

                    <a href="/CategoriesProducts"
                       class="btn btn-secondary px-4 rounded-pill">

                        View Data
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">