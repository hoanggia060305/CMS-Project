@model List<CMS.Data.Entities.OrderDetail>

<h2>DANH SÁCH CHI TIẾT ĐƠN HÀNG</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Mã đơn hàng</th>
            <th>Mã sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.OrderId</td>

                <td>@item.ProductId</td>

                <td>@item.Quantity</td>

                <td>
                    @item.UnitPrice.ToString("N0") VNĐ
                </td>

                <td>
                    @((item.Quantity * item.UnitPrice).ToString("N0")) VNĐ
                </td>
            </tr>
        }
    </tbody>
</table>