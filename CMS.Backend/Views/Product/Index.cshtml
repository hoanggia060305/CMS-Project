@model IEnumerable<CMS.Data.Entities.Product>

<h2>Danh sách Products</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Mô tả</th>
            <th>Giá</th>
            <th>Số lượng tồn</th>
            <th>Hình ảnh</th>
            <th>CategoryProductId</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Price</td>
                <td>@item.StockQuantity</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl"
                             width="100"
                             height="100"
                             style="object-fit:cover;" />
                    }
                </td>

                <td>@item.CategoryProductId</td>
            </tr>
        }
    </tbody>
</table>